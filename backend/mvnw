#!/bin/sh
set -e

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
DIST_DIR="$WRAPPER_DIR/dists/apache-maven-3.9.9"
MAVEN_CMD="$DIST_DIR/bin/mvn"
MAVEN_ZIP="$WRAPPER_DIR/apache-maven-3.9.9-bin.zip"
MAVEN_URL="https://archive.apache.org/dist/maven/maven-3/3.9.9/binaries/apache-maven-3.9.9-bin.zip"

if [ ! -x "$MAVEN_CMD" ]; then
  mkdir -p "$WRAPPER_DIR/dists"
  if [ ! -f "$MAVEN_ZIP" ]; then
    echo "Downloading Maven 3.9.9..."
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "$MAVEN_URL" -o "$MAVEN_ZIP"
    else
      wget -q "$MAVEN_URL" -O "$MAVEN_ZIP"
    fi
  fi
  rm -rf "$DIST_DIR"
  unzip -q "$MAVEN_ZIP" -d "$WRAPPER_DIR/dists"
fi

exec "$MAVEN_CMD" "$@"
