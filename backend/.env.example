# Server
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
FRONTEND_ALT_URL=http://localhost:5174
FRONTEND_IP_URL=http://127.0.0.1:5173
FRONTEND_IP_ALT_URL=http://127.0.0.1:5174

# MySQL
DB_URL=jdbc:mysql://localhost:3306/english_learning?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=123456
DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# JPA
JPA_SHOW_SQL=false

# JWT - replace in real development/production
JWT_ACCESS_SECRET=change-this-access-secret-key-to-at-least-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret-key-to-at-least-32-characters
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=14
RESET_PASSWORD_EXPIRATION_MINUTES=15
RESET_PASSWORD_URL=http://localhost:5173/reset-password
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# AI - API key stays on backend only
AI_PROVIDER=openai
AI_MODEL=gpt-5.6-sol
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_DAILY_USAGE_LIMIT=50
AI_FALLBACK_ENABLED=true

# Mock payment webhook signing (no real payment provider is integrated)
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
